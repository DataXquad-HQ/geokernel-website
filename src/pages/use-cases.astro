---
import '../styles/global.css';
import UseCasesApp from '../views/UseCasesApp.jsx';

const SITE = 'https://busycow.dataxquad.com';
const pageUrl = `${SITE}/use-cases`;
const title = 'Use Cases - BusyCow';
const description = 'Explore how BusyCow automates HR, finance, sales, operations and more — real use cases across every department.';
const ogImage = `${SITE}/og-image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
  </head>
  <body>
    <UseCasesApp client:load />
  </body>
</html>
