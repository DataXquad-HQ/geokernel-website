---
import { marked } from 'marked';
import Layout from '../../../layouts/Layout.astro';
import { getPosts, getPostBySlug } from '../../../lib/notion.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { lang: post.language ?? 'zh', slug: post.slug },
  }));
}

const { lang, slug } = Astro.params;
const post = await getPostBySlug(lang as string, slug as string);

if (!post) throw new Error(`Post not found: ${lang}/${slug}`);

const htmlContent = marked.parse(post.markdown ?? '', { async: false });

const pageUrl = Astro.url.href;
const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(post.title);

const TAG_PALETTE = [
  { bg: '#F0FDFB', text: '#0D7370', border: '#0D9488' },
  { bg: '#EEF2FF', text: '#4338CA', border: '#6366F1' },
  { bg: '#FFF7ED', text: '#C2410C', border: '#F97316' },
  { bg: '#F0FDF4', text: '#15803D', border: '#22C55E' },
  { bg: '#FDF4FF', text: '#7E22CE', border: '#A855F7' },
  { bg: '#EFF6FF', text: '#1D4ED8', border: '#3B82F6' },
];

const TAG_INDEX: Record<string, number> = {
  'Case Study': 0, '案例研究': 0,
  'Tutorial': 1, '教學': 1,
  'Industry Insight': 2, '產業洞察': 2,
  'Company News': 3, '公司動態': 3,
  'Product Update': 4, '產品更新': 4,
};

function tagStyle(tag: string) {
  const idx = TAG_INDEX[tag] ?? (tag.charCodeAt(0) % TAG_PALETTE.length);
  return TAG_PALETTE[idx];
}

const shareLinks = {
  twitter: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  whatsapp: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
};

const dateLocale = lang === 'zh' ? 'zh-TW' : 'en-US';
---

<Layout
  title={`${post.title} - GeoKernel Blog`}
  description={post.description ?? undefined}
  ogImage={post.cover ?? undefined}
  canonicalUrl={Astro.url.href}
>
  <!-- Back link -->
  <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-[#0D9488] transition-colors mb-8 group">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
    {lang === 'zh' ? '回到 Blog' : 'Back to Blog'}
  </a>

  <!-- Cover image -->
  {post.cover && (
    <div class="rounded-2xl overflow-hidden mb-8 aspect-[16/7] bg-gray-50">
      <img src={post.cover} alt={post.title} class="w-full h-full object-cover" />
    </div>
  )}

  <!-- Article header -->
  <header class="mb-8">
    {post.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {post.tags.map((tag: string) => {
          const s = tagStyle(tag);
          return (
            <span
              style={`background:${s.bg};color:${s.text};border-color:${s.border}`}
              class="text-xs font-semibold px-3 py-1 rounded-full border"
            >
              {tag}
            </span>
          );
        })}
      </div>
    )}

    <h1 class="text-3xl font-bold leading-tight text-[#1F2937] mb-3">{post.title}</h1>

    {post.date && (
      <time class="text-sm text-gray-400">
        {new Date(post.date).toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
    )}
  </header>

  <!-- Article content -->
  <article class="prose prose-neutral max-w-none prose-headings:text-[#1F2937] prose-a:text-[#0D9488] prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl" set:html={htmlContent} />

  <!-- Share section -->
  <div class="mt-12 pt-8 border-t border-gray-100">
    <p class="text-sm font-semibold text-gray-400 uppercase tracking-widest mb-4">
      {lang === 'zh' ? '分享這篇文章' : 'Share this article'}
    </p>
    <div class="flex flex-wrap gap-3">
      <button
        id="copy-btn"
        class="share-btn inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-200 text-sm font-medium text-gray-600 hover:border-[#0D9488] hover:text-[#0D9488] transition-all duration-200 bg-white"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        {lang === 'zh' ? '複製連結' : 'Copy link'}
      </button>

      <a href={shareLinks.twitter} target="_blank" rel="noopener noreferrer"
        class="share-btn inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-200 text-sm font-medium text-gray-600 hover:border-black hover:text-black transition-all duration-200 bg-white">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        Twitter / X
      </a>

      <a href={shareLinks.linkedin} target="_blank" rel="noopener noreferrer"
        class="share-btn inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-200 text-sm font-medium text-gray-600 hover:border-[#0A66C2] hover:text-[#0A66C2] transition-all duration-200 bg-white">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        LinkedIn
      </a>

      <a href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer"
        class="share-btn inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-200 text-sm font-medium text-gray-600 hover:border-[#25D366] hover:text-[#25D366] transition-all duration-200 bg-white">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
        WhatsApp
      </a>
    </div>

    <div id="copy-toast" class="hidden mt-3 inline-flex items-center gap-1.5 text-sm text-[#0D9488] font-medium">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      {lang === 'zh' ? '已複製連結！' : 'Link copied!'}
    </div>
  </div>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-btn');
  const toast = document.getElementById('copy-toast');

  copyBtn?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(window.location.href);
    toast?.classList.remove('hidden');
    setTimeout(() => toast?.classList.add('hidden'), 2500);
  });
</script>
