---
import Layout from '../../layouts/Layout.astro';
import { getPostBySlug } from '../../lib/notion.js';
import { marked } from 'marked';

const { slug } = Astro.params;

// SSR: 從 URL 取得 lang，預設 zh
const lang = Astro.url.searchParams.get('lang') ?? 'zh';
const post = await getPostBySlug(lang, slug);

if (!post) {
  return Astro.redirect('/blog');
}

const contentHtml = marked(post.markdown ?? '');
---

<Layout title={post.title}>
  <article class="max-w-3xl mx-auto">
    <!-- Back link -->
    <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-[#0D9488] transition-colors mb-8">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      返回 Blog
    </a>

    <!-- Cover image -->
    {post.cover && (
      <div class="aspect-[16/9] rounded-2xl overflow-hidden mb-8 bg-gray-100">
        <img src={post.cover} alt={post.title} class="w-full h-full object-cover" />
      </div>
    )}

    <!-- Tags -->
    {post.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {post.tags.map((tag: string) => (
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full border bg-[#F0FDFB] text-[#0D7370] border-[#0D9488]">
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- Title -->
    <h1 class="text-3xl md:text-4xl font-bold text-[#1F2937] leading-tight mb-4">
      {post.title}
    </h1>

    <!-- Meta -->
    <div class="flex items-center gap-4 text-sm text-gray-400 mb-8 pb-8 border-b border-gray-100">
      {post.date && (
        <time>
          {new Date(post.date).toLocaleDateString('zh-TW', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      )}
    </div>

    <!-- Content -->
    <div
      class="prose prose-lg max-w-none prose-headings:text-[#1F2937] prose-a:text-[#0D9488] prose-a:no-underline hover:prose-a:underline"
      set:html={contentHtml}
    />
  </article>
</Layout>
